{
  "name": "titi",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Titi — offline-first walkie-talkie for Android, iOS and web",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "gates": "pwsh -NoProfile -File scripts/gates.ps1",
    "proto:gen": "pnpm dlx @bufbuild/buf@1.73.0 generate",
    "proto:lint": "pnpm dlx @bufbuild/buf@1.73.0 lint",
    "core:test": "cargo test --manifest-path core/Cargo.toml",
    "core:vectors": "cargo run --manifest-path core/Cargo.toml -p titi-core --bin gen-vectors --features vectors",
    "core:wasm": "pwsh -NoProfile -File scripts/build-wasm.ps1",
    "android:debug": "android/gradlew.bat -p android :app:assembleGmsDebug :wear:assembleDebug",
    "android:release": "android/gradlew.bat -p android :app:bundleGmsRelease :wear:bundleRelease"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@resvg/resvg-js": "2.6.2",
    "lefthook": "2.1.14",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7",
      "esbuild": ">=0.28.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@hono/node-ws>@hono/node-server": "2"
      }
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
