{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["pnpm-lock.yaml", "tsconfig.base.json", ".oxlintrc.json"],
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!**/*.test.ts", "!**/*.md"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "pkg/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {
      "dependsOn": ["^transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^transit", "^build"],
      "inputs": ["src/**", "test/**", "vitest.config.ts", "tsconfig.json", "package.json"],
      "outputs": []
    }
  }
}
