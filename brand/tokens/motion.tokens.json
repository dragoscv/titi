        "value": 200,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 320,
        "unit": "ms"
      }
    },
    "brand": {
      "$value": {
        "value": 900,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "enter": {
      "$value": [
        0.05,
        0.7,
        0.1,
        1
      ],
      "$description": "M3 emphasized decelerate"
    },
    "exit": {
      "$value": [
        0.3,
        0,
        0.8,
        0.15
      ],
      "$description": "M3 emphasized accelerate"
    },
    "move": {
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "M3 standard"
    },
    "chirp": {
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "$description": "logo only: the 'chirp' overshoot (legacy --ease-spring)"
