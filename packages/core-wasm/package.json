{
  "name": "@titi/core-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "wasm-bindgen output of core/titi-wasm (generated by scripts/build-wasm.ps1)",
  "main": "./pkg/titi_wasm.js",
  "types": "./pkg/titi_wasm.d.ts",
  "exports": {
    ".": { "types": "./pkg/titi_wasm.d.ts", "default": "./pkg/titi_wasm.js" },
    "./pkg/*": "./pkg/*"
  },
  "files": ["pkg"],
  "scripts": {
    "build": "pwsh -NoProfile -File ../../scripts/build-wasm.ps1"
  }
}
