{
  "name": "@titi/app-ui",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Shared React UI + store for web, desktop (Tauri) and TV hosts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./theme.css": "./src/theme.css",
    "./tv": "./src/tv/index.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json src",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@titi/core-wasm": "workspace:*",
    "@titi/protocol": "workspace:*",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "qrcode": "catalog:",
    "tailwind-merge": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
