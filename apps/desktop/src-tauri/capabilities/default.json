{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Titi UI: core events + notifications only",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "notification:default",
    "deep-link:default"
  ]
}
